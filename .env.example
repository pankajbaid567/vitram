# Copy to .env (git-ignored). Every integration is optional; without it VITTRM
# shows a clearly labelled "not configured" state instead of pretending to work.

# --- core ---------------------------------------------------------------
# ENV=development
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/vitram   # default: SQLite in backend/.data (uv sync --extra postgres)
# AUTO_MIGRATE=true   # apply Alembic migrations at start-up (SQLite is backed up first); set false in production
# Fernet key for encrypting uploaded files at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when ENV=production; auto-generated into backend/.data/dev.key otherwise.
VITRAM_DATA_KEY=
APP_ORIGIN=http://localhost:5173
# Session cookie "Secure" flag. Unset: on when ENV=production or the request is HTTPS. Set false only for plain-HTTP local runs.
# SESSION_COOKIE_SECURE=
# Dev server: API port to proxy /api to (frontend reads this; default http://127.0.0.1:8000)
# API_PROXY_TARGET=http://127.0.0.1:8000

# --- docker compose --------------------------------------------------------
# POSTGRES_PASSWORD=vitram
# WEB_PORT=8080
# Public HTTPS URL of the API (needed for OpenWA/Twilio webhooks, e.g. a tunnel)
PUBLIC_API_URL=

# --- Gemini (Vitt Saathi chat + Live voice) -------------------------------
# Model ids are intentionally not defaulted: use the ids available to your key at build time.
GEMINI_API_KEY=
GEMINI_MODEL=
# Provider deadline in milliseconds. Minimum 10000; failures fall back to Tool mode.
# GEMINI_TIMEOUT_MS=10000
GEMINI_LIVE_MODEL=

# Reading photos and scanned PDFs (OCR). auto = on-device Apple Vision on macOS (nothing leaves the machine), else none.
# gemini = send scans to Gemini (explicit opt-in); uses GEMINI_VISION_MODEL, falling back to GEMINI_MODEL.
# OCR_PROVIDER=auto
GEMINI_VISION_MODEL=
# OCR_MAX_PAGES=30

# Outgoing account email for verification and password-reset links. Without SMTP_HOST and SMTP_FROM, delivery is unavailable.
SMTP_HOST=
# SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_STARTTLS=true

# --- WhatsApp -------------------------------------------------------------
# Which gateway sends and receives: "meta" (official Cloud API; production) or "openwa" (unofficial; dev/demo only).
WHATSAPP_PROVIDER=openwa

# Meta WhatsApp Cloud API (WHATSAPP_PROVIDER=meta). Needs a verified business, a number, and an APPROVED template
# with three body variables:  "VITTRM reminder: {{1}} of {{2}} is due {{3}}."  (category: Utility).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REMINDER_TEMPLATE=
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_GRAPH_VERSION=v21.0

# OpenWA (WHATSAPP_PROVIDER=openwa): self-hosted, UNOFFICIAL. Start ./OpenWA, pair a dedicated WhatsApp number,
# and create an API key scoped to that session. The webhook secret must be at least 16 characters.
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=
# OPENWA_TIMEOUT_SECONDS=15

# --- Twilio Programmable Voice (insurance consultation calls) ------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CONSULTANT_PHONE_NUMBER=
# Separate Verify v2 Service SID (VA...) for SMS possession checks.
TWILIO_VERIFY_SERVICE_SID=

# SMTP_USER is also accepted as a legacy alias for SMTP_USERNAME.
