// One free Cloudflare Worker: web app + /api proxy + keep-awake cron. Deploy with `npx wrangler deploy` from this folder
// after `npm run build` in ../../frontend. Set API_ORIGIN to the API's public URL before deploying.
{
  "name": "vitram",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "API_ORIGIN": "https://vitram-api-pb.onrender.com" },
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
