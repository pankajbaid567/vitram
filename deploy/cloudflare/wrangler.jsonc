// One free Cloudflare Worker: web app + /api proxy + keep-awake cron. Deploy with `npx wrangler deploy` from this folder
// after `npm run build` in ../../frontend. Set API_ORIGIN to the API's public URL before deploying.
{
  "name": "vitram",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://vitram-api-pb.onrender.com",
    "KEEPALIVE_URLS": "https://vitram-openwa-pb.onrender.com/api/health/ready"
  },
  // Edge flood guard: 300 API requests per minute per client IP (the API enforces finer per-user budgets).
  "unsafe": { "bindings": [{ "name": "EDGE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }] },
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
