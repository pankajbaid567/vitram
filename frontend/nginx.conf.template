# Pass the client-facing scheme through when an outer proxy already terminated TLS; otherwise use ours.
map $http_x_forwarded_proto $fwd_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

# nginx fills ${API_UPSTREAM} (the only variable substituted; see NGINX_ENVSUBST_FILTER in the Dockerfile).
# Serves the SPA and forwards /api to the backend service (same origin, so the session cookie and CSRF origin check just work).
server {
  listen 8080;
  root /usr/share/nginx/html;
  client_max_body_size 16m;   # backend limit is 15 MB per upload

  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $http_host;   # keep the port: the backend compares Host with Origin
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_read_timeout 120s;   # document processing and model calls can be slow
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;   # client-side routing
  }
}
